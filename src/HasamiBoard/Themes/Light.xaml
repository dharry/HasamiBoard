<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2D7DFF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EAF1FF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E53935" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="FlashBrush" Color="#FFF59D" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F3F3F3" />

    <!-- 機能アイコンの配色 (設定/カラーピッカー/編集 等) -->
    <SolidColorBrush x:Key="SettingsIconBrush" Color="#5C6BC0" />
    <SolidColorBrush x:Key="ColorPickerIconBrush" Color="#D81B60" />
    <SolidColorBrush x:Key="EditIconBrush" Color="#1976D2" />
    <SolidColorBrush x:Key="CopyIconBrush" Color="#00897B" />
    <SolidColorBrush x:Key="TagIconBrush" Color="#8E24AA" />
    <SolidColorBrush x:Key="SearchIconBrush" Color="#0097A7" />
    <SolidColorBrush x:Key="FolderIconBrush" Color="#EF6C00" />
    <SolidColorBrush x:Key="MemoIconBrush" Color="#43A047" />
    <SolidColorBrush x:Key="ConverterIconBrush" Color="#00838F" />
    <SolidColorBrush x:Key="ErrorListIconBrush" Color="#E64A19" />

</ResourceDictionary>

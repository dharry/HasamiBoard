<Window x:Class="HasamiBoard.Views.ColorPickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Canvas>
        <Border x:Name="LoupePanel"
                Background="#F0202225"
                BorderBrush="#66FFFFFF" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <StackPanel Width="150">
                <Border Width="120" Height="120" CornerRadius="4" ClipToBounds="True"
                        BorderBrush="White" BorderThickness="1" HorizontalAlignment="Center">
                    <Grid>
                        <Image x:Name="MagnifierImage" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border x:Name="ColorSwatch" Height="18" Margin="0,8,0,4" CornerRadius="3" />
                <TextBlock x:Name="HexText" Foreground="White" FontFamily="Consolas" FontSize="14"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="RgbText" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="11"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>

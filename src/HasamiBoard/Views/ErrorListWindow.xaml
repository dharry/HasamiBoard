<Window x:Class="HasamiBoard.Views.ErrorListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:HasamiBoard.Services"
        xmlns:converters="clr-namespace:HasamiBoard.Converters"
        Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_WindowTitle]}"
        Width="760" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Topmost="{Binding IsTopmost}"
        FontFamily="{Binding UiFontFamily}"
        FontSize="{Binding UiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibilityConverter" />

        <Style x:Key="SidebarModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ヘッダー: フォント設定 / 常に手前に表示トグル -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,4" LastChildFill="False">
            <ToggleButton DockPanel.Dock="Right"
                          Style="{StaticResource PinToggleButtonStyle}"
                          IsChecked="{Binding IsTopmost, Mode=OneWay}"
                          Command="{Binding ToggleTopmostCommand}"
                          ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Pin]}"
                          AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Pin]}" />

            <Button x:Name="FontSettingsButton" DockPanel.Dock="Right" Content="🔤"
                    Style="{StaticResource IconButtonStyle}"
                    Click="FontSettingsButton_Click"
                    ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[MemoFontPanel_Title]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[MemoFontPanel_Title]}" />

            <Popup x:Name="FontSettingsPopup" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=FontSettingsButton}"
                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[MemoFontPanel_Title]}"
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,6"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Font_ErrorListUi]}"
                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="150" Margin="0,0,6,0" IsEditable="True"
                                      ItemsSource="{Binding AvailableFontFamilies}"
                                      Text="{Binding UiFontFamily, Mode=TwoWay}" />
                            <ComboBox Width="55" IsEditable="True"
                                      Text="{Binding UiFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem>11</ComboBoxItem>
                                <ComboBoxItem>12</ComboBoxItem>
                                <ComboBoxItem>13</ComboBoxItem>
                                <ComboBoxItem>14</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>18</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Font_ErrorListEdit]}"
                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="150" Margin="0,0,6,0" IsEditable="True"
                                      ItemsSource="{Binding AvailableFontFamilies}"
                                      Text="{Binding EditFontFamily, Mode=TwoWay}" />
                            <ComboBox Width="55" IsEditable="True"
                                      Text="{Binding EditFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem>11</ComboBoxItem>
                                <ComboBoxItem>12</ComboBoxItem>
                                <ComboBoxItem>13</ComboBoxItem>
                                <ComboBoxItem>14</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>18</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </DockPanel>

        <!-- サイドバー: カテゴリ一覧 -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8">
                <RadioButton GroupName="ErrorListModes" Style="{StaticResource SidebarModeButtonStyle}"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_Mode_Http]}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Http, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="Http" />
                <RadioButton GroupName="ErrorListModes" Style="{StaticResource SidebarModeButtonStyle}"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_Mode_Errno]}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Errno, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="Errno" />
                <RadioButton GroupName="ErrorListModes" Style="{StaticResource SidebarModeButtonStyle}"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_Mode_WindowsError]}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=WindowsError, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="WindowsError" />
                <RadioButton GroupName="ErrorListModes" Style="{StaticResource SidebarModeButtonStyle}"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_Mode_Smtp]}"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Smtp, Mode=OneWay}"
                             Command="{Binding SelectModeCommand}" CommandParameter="Smtp" />
            </StackPanel>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 検索ボックス ＆ 言語切替 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Grid.Column="0" Style="{StaticResource StandardTextBoxStyle}" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_Search]}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="ErrorListLanguage" Margin="0,0,14,0" Foreground="{DynamicResource PrimaryTextBrush}"
                                 Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_LanguageEn]}"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=En, Mode=OneWay}"
                                 Command="{Binding SelectLanguageCommand}" CommandParameter="En" />
                    <RadioButton GroupName="ErrorListLanguage" Foreground="{DynamicResource PrimaryTextBrush}"
                                 Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_LanguageJa]}"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Ja, Mode=OneWay}"
                                 Command="{Binding SelectLanguageCommand}" CommandParameter="Ja" />
                </StackPanel>
            </Grid>

            <!-- 列ヘッダー -->
            <Grid Grid.Row="1" Margin="8,0,34,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeaderLabelStyle}" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_ColumnCode]}" />
                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderLabelStyle}" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_ColumnMacro]}" />
                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderLabelStyle}" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_ColumnDescription]}" />
            </Grid>

            <!-- 一覧 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
                <Grid>
                    <ListBox ItemsSource="{Binding FilteredEntries}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="2,2"
                             VirtualizingPanel.CacheLengthUnit="Page">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="Bold"
                                                   FontFamily="{Binding DataContext.EditFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding DataContext.EditFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding MacroName}" Margin="0,0,8,0"
                                                   FontFamily="{Binding DataContext.EditFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding DataContext.EditFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Top" TextWrapping="Wrap"
                                                   Visibility="{Binding MacroName, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding DescriptionEn}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Visibility="{Binding DataContext.SelectedLanguage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=En}" />
                                            <TextBlock Text="{Binding DescriptionJa}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Visibility="{Binding DataContext.SelectedLanguage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Ja}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Style="{StaticResource CardIconButtonStyle}" Content="📋" Foreground="{DynamicResource CopyIconBrush}"
                                                Command="{Binding DataContext.CopyEntryAsJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_CopyAsJson]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_CopyAsJson]}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ErrorList_NoResults]}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding FilteredEntries.Count, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

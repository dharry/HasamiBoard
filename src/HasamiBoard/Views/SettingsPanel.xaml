<UserControl x:Class="HasamiBoard.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HasamiBoard.ViewModels"
             xmlns:converters="clr-namespace:HasamiBoard.Converters"
             xmlns:services="clr-namespace:HasamiBoard.Services">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibilityConverter" />
        <converters:IndexToBoolConverter x:Key="IndexToBoolConverter" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style x:Key="SmallTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource StandardTextBoxStyle}">
            <Setter Property="Width" Value="60" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="16,16,16,0"
                       Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Title]}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <!-- サブタブ -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,4">
                <RadioButton Style="{StaticResource SettingsTabButtonStyle}" GroupName="SettingsSubTabs"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Tab_General]}"
                             IsChecked="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=0, Mode=OneWay}"
                             Command="{Binding Settings.SelectSettingsTabCommand}" CommandParameter="0" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource SettingsTabButtonStyle}" GroupName="SettingsSubTabs"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Tab_Screenshot]}"
                             IsChecked="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=1, Mode=OneWay}"
                             Command="{Binding Settings.SelectSettingsTabCommand}" CommandParameter="1" Margin="4,0" />
                <RadioButton Style="{StaticResource SettingsTabButtonStyle}" GroupName="SettingsSubTabs"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Tab_Tools]}"
                             IsChecked="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=2, Mode=OneWay}"
                             Command="{Binding Settings.SelectSettingsTabCommand}" CommandParameter="2" Margin="4,0" />
                <RadioButton Style="{StaticResource SettingsTabButtonStyle}" GroupName="SettingsSubTabs"
                             Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Fonts]}"
                             IsChecked="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=3, Mode=OneWay}"
                             Command="{Binding Settings.SelectSettingsTabCommand}" CommandParameter="3" Margin="4,0,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="16,0,16,16">

                    <!-- ============ 一般 ============ -->
                    <StackPanel Visibility="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Language]}"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,2" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Language, Mode=TwoWay}">
                            <ComboBoxItem Tag="auto" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Language_Auto]}" />
                            <ComboBoxItem Tag="ja" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Language_Japanese]}" />
                            <ComboBoxItem Tag="en" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Language_English]}" />
                        </ComboBox>

                        <CheckBox Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,4"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_DarkMode]}"
                                  IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_QuickFilterVisible]}"
                                  IsChecked="{Binding IsQuickFilterVisible, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AutoStart]}"
                                  IsChecked="{Binding Settings.IsAutoStart, Mode=TwoWay}" />

                        <!-- 機能の有効/無効 -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_FeatureToggles]}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Feature_History]}"
                                  IsChecked="{Binding IsHistoryTabEnabled, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Feature_Screenshot]}"
                                  IsChecked="{Binding IsScreenshotTabEnabled, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Feature_Memo]}"
                                  IsChecked="{Binding IsMemoTabEnabled, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Feature_Converter]}"
                                  IsChecked="{Binding IsConverterEnabled, Mode=TwoWay}" />

                        <!-- 表示調整 -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ItemHeight]}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="30" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.ItemMaxHeight, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Settings.ItemMaxHeight, StringFormat={}{0:0}px}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ThumbnailHeight]}"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="60" Maximum="260" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.ScreenshotThumbnailHeight, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Settings.ScreenshotThumbnailHeight, StringFormat={}{0:0}px}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 保持数上限 -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_MaxHistoryCount]}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="20" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.MaxHistoryCount, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Settings.MaxHistoryCount}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_MaxScreenshotCount]}"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="20" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.MaxScreenshotHistoryCount, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Settings.MaxScreenshotHistoryCount}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- マスタータグ管理 -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_MasterTags]}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding Settings.MasterTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MasterTagEditViewModel}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="ColorDot" Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenColorPickerCommand}" />
                                            </Border.InputBindings>
                                        </Border>

                                        <Popup IsOpen="{Binding IsColorPickerOpen}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=ColorDot}" Placement="Bottom"
                                               AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8">
                                                <ItemsControl ItemsSource="{x:Static vm:MasterTagEditViewModel.Palette}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Width="120" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="20" Height="20" Margin="2" CornerRadius="10" Cursor="Hand"
                                                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding PlacementTarget.DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                                  CommandParameter="{Binding}" />
                                                                </Border.InputBindings>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Cursor="Hand"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                                       MouseLeftButtonDown="MasterTagName_MouseLeftButtonDown"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                       ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_TagRenameHint]}" />
                                            <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource StandardTextBoxStyle}" FontSize="12" Padding="4,2"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     LostFocus="MasterTagNameEditTextBox_LostFocus"
                                                     PreviewKeyDown="MasterTagNameEditTextBox_PreviewKeyDown" />
                                        </Grid>

                                        <Button Grid.Column="2" Content="✕" Command="{Binding DeleteCommand}"
                                                Width="20" Height="20" Padding="0" FontSize="10"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource DangerBrush}" Cursor="Hand"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource StandardTextBoxStyle}" Margin="0,0,6,0"
                                     Text="{Binding Settings.NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_NewTagPlaceholder]}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AddTag]}"
                                    Command="{Binding Settings.AddTagCommand}" Padding="10,4" />
                        </Grid>

                        <!-- フォルダ / バックアップ / リセット -->
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,20,0,6" HorizontalAlignment="Stretch"
                                Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_OpenDataFolder]}"
                                Command="{Binding Settings.OpenDataFolderCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_CreateBackup]}"
                                Command="{Binding Settings.CreateBackupCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_RestoreBackup]}"
                                Command="{Binding Settings.RestoreBackupCommand}" Margin="0,0,0,6" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ResetToDefault]}"
                                Command="{Binding Settings.ResetToDefaultCommand}" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding Settings.AppVersion}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,10,0,20" />
                    </StackPanel>

                    <!-- ============ スクリーンショット ============ -->
                    <StackPanel Visibility="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ScreenshotFormat]}"
                                   Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ImgFormat" Content="PNG" Margin="0,0,12,0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         IsChecked="{Binding Settings.IsPngFormat, Mode=OneWay}"
                                         Checked="PngRadio_Checked" />
                            <RadioButton GroupName="ImgFormat" Content="JPG" Margin="0,0,12,0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         IsChecked="{Binding Settings.IsJpegFormat, Mode=OneWay}"
                                         Checked="JpgRadio_Checked" />
                            <RadioButton GroupName="ImgFormat" Content="WEBP"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         IsChecked="{Binding Settings.IsWebpFormat, Mode=OneWay}"
                                         Checked="WebpRadio_Checked" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Settings.IsJpegFormat, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_JpegQuality]}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="1" Maximum="100"
                                        Value="{Binding Settings.ScreenshotJpegQuality, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.ScreenshotJpegQuality}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Settings.IsWebpFormat, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_WebpQuality]}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="1" Maximum="100"
                                        Value="{Binding Settings.ScreenshotWebpQuality, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.ScreenshotWebpQuality}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <CheckBox Style="{StaticResource CheckBoxStyle}"
                                      Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_WebpLossless]}"
                                      IsChecked="{Binding Settings.ScreenshotWebpLossless, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,4"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_DominantColor]}"
                                  IsChecked="{Binding Settings.IsDominantColorExtractionEnabled, Mode=TwoWay}" />

                        <!-- ホットキー -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ScreenshotHotkey]}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_HotkeyEnabled]}"
                                  IsChecked="{Binding Settings.IsScreenshotHotkeyEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="110" Margin="0,0,6,0"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Settings.ScreenshotHotkeyModifiers, Mode=TwoWay}">
                                <ComboBoxItem Tag="Ctrl+Shift" Content="Ctrl+Shift" />
                                <ComboBoxItem Tag="Ctrl+Alt" Content="Ctrl+Alt" />
                                <ComboBoxItem Tag="Ctrl+Win" Content="Ctrl+Win" />
                                <ComboBoxItem Tag="Alt+Shift" Content="Alt+Shift" />
                            </ComboBox>
                            <TextBox Style="{StaticResource SmallTextBoxStyle}" MaxLength="1"
                                     Text="{Binding Settings.ScreenshotHotkeyKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ ツール ============ -->
                    <StackPanel Visibility="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ColorPickerHotkey]}"
                                   Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,6" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_HotkeyEnabled]}"
                                  IsChecked="{Binding Settings.IsColorPickerHotkeyEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="110" Margin="0,0,6,0"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Settings.ColorPickerHotkeyModifiers, Mode=TwoWay}">
                                <ComboBoxItem Tag="Ctrl+Shift" Content="Ctrl+Shift" />
                                <ComboBoxItem Tag="Ctrl+Alt" Content="Ctrl+Alt" />
                                <ComboBoxItem Tag="Ctrl+Win" Content="Ctrl+Win" />
                                <ComboBoxItem Tag="Alt+Shift" Content="Alt+Shift" />
                            </ComboBox>
                            <TextBox Style="{StaticResource SmallTextBoxStyle}" MaxLength="1"
                                     Text="{Binding Settings.ColorPickerHotkeyKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ConverterHotkey]}"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,2" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_HotkeyEnabled]}"
                                  IsChecked="{Binding Settings.IsConverterHotkeyEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="110" Margin="0,0,6,0"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Settings.ConverterHotkeyModifiers, Mode=TwoWay}">
                                <ComboBoxItem Tag="Ctrl+Shift" Content="Ctrl+Shift" />
                                <ComboBoxItem Tag="Ctrl+Alt" Content="Ctrl+Alt" />
                                <ComboBoxItem Tag="Ctrl+Win" Content="Ctrl+Win" />
                                <ComboBoxItem Tag="Alt+Shift" Content="Alt+Shift" />
                            </ComboBox>
                            <TextBox Style="{StaticResource SmallTextBoxStyle}" MaxLength="1"
                                     Text="{Binding Settings.ConverterHotkeyKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ErrorListHotkey]}"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,2" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                  Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_HotkeyEnabled]}"
                                  IsChecked="{Binding Settings.IsErrorListHotkeyEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <ComboBox Width="110" Margin="0,0,6,0"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Settings.ErrorListHotkeyModifiers, Mode=TwoWay}">
                                <ComboBoxItem Tag="Ctrl+Shift" Content="Ctrl+Shift" />
                                <ComboBoxItem Tag="Ctrl+Alt" Content="Ctrl+Alt" />
                                <ComboBoxItem Tag="Ctrl+Win" Content="Ctrl+Win" />
                                <ComboBoxItem Tag="Alt+Shift" Content="Alt+Shift" />
                            </ComboBox>
                            <TextBox Style="{StaticResource SmallTextBoxStyle}" MaxLength="1"
                                     Text="{Binding Settings.ErrorListHotkeyKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ConverterModes]}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding Settings.ConverterModeCategoryGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2" />
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="8,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="▲" Command="{Binding MoveUpCommand}"
                                                                Width="20" Height="20" Padding="0" FontSize="9" Margin="0,0,2,0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand"
                                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_MoveUp]}" />
                                                        <Button Grid.Column="1" Content="▼" Command="{Binding MoveDownCommand}"
                                                                Width="20" Height="20" Padding="0" FontSize="9" Margin="0,0,8,0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand"
                                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_MoveDown]}" />
                                                        <CheckBox Grid.Column="2" Style="{StaticResource CheckBoxStyle}"
                                                                  Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============ フォント ============ -->
                    <StackPanel Visibility="{Binding Settings.SettingsTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=3}">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Font_History]}"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="170" Margin="0,0,6,0"
                                      ItemsSource="{Binding Settings.AvailableFontFamilies}"
                                      Text="{Binding Settings.HistoryFontFamily, Mode=TwoWay}" IsEditable="True" />
                            <ComboBox Width="60" IsEditable="True"
                                      Text="{Binding Settings.HistoryFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem>11</ComboBoxItem>
                                <ComboBoxItem>12</ComboBoxItem>
                                <ComboBoxItem>13</ComboBoxItem>
                                <ComboBoxItem>14</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>18</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Font_ScreenshotMemo]}"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Orientation="Horizontal">

<UserControl x:Class="HasamiBoard.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HasamiBoard.ViewModels"
             xmlns:converters="clr-namespace:HasamiBoard.Converters"
             xmlns:services="clr-namespace:HasamiBoard.Services">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

        <DataTemplate x:Key="TagBadgeTemplate" DataType="{x:Type vm:TagBadgeViewModel}">
            <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                    CornerRadius="10" Padding="7,2" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name, StringFormat=#{0}}" Foreground="White" FontSize="11"
                               Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ClickCommand}" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <Button Content="✕" Command="{Binding RemoveCommand}"
                            Margin="4,0,0,0" Padding="0" Width="14" Height="14" FontSize="9"
                            Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_RemoveTag]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_RemoveTag]}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CardIconButtonStyle}" Content="🗑️"
                    Foreground="{DynamicResource DangerBrush}"
                    Command="{Binding ClearAllCommand}"
                    ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_ClearAll]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_ClearAll]}" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CardIconButtonStyle}" Content="🧹"
                    Command="{Binding CleanOrphanedImagesCommand}"
                    ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_CleanOrphans]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_CleanOrphans]}" />

            <!-- 複数選択時の一括操作バー -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectionCountText}"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Style="{StaticResource CardIconButtonStyle}" Content="📌"
                        Command="{Binding TogglePinSelectedCommand}"
                        ToolTip="{Binding BulkPinButtonLabel}"
                        AutomationProperties.Name="{Binding BulkPinButtonLabel}" />
                <Button Style="{StaticResource CardIconButtonStyle}" Content="📋"
                        Foreground="{DynamicResource CopyIconBrush}"
                        Command="{Binding CopySelectedToClipboardCommand}"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_CopyNote]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_CopyNote]}" />
                <Button x:Name="BulkTagButton"
                        Style="{StaticResource CardIconButtonStyle}" Content="🏷️+"
                        Foreground="{DynamicResource TagIconBrush}"
                        Command="{Binding OpenBulkTagPickerCommand}"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Selection_AddTag]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Selection_AddTag]}" />
                <Popup x:Name="BulkTagPickerPopup" IsOpen="{Binding IsBulkTagPickerOpen}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=BulkTagButton}"
                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="140">
                        <ItemsControl ItemsSource="{Binding MasterTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4,3" Cursor="Hand"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Command="{Binding PlacementTarget.DataContext.AddTagToSelectedCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                            CommandParameter="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
                <Button Style="{StaticResource CardIconButtonStyle}" Content="🗑️"
                        Foreground="{DynamicResource DangerBrush}"
                        Command="{Binding DeleteSelectedCommand}"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Screenshot_Empty]}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ListBox x:Name="ScreenshotListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 SelectionMode="Extended"
                 SelectionChanged="ScreenshotListBox_SelectionChanged"
                 PreviewKeyDown="ScreenshotListBox_PreviewKeyDown"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLengthUnit="Pixel"
                 VirtualizingPanel.CacheLength="200,200"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ContextMenu_EditNote]}"
                                          Command="{Binding BeginEditNoteCommand}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_Ocr]}"
                                          Command="{Binding RunOcrCommand}"
                                          IsEnabled="{Binding CanRunOcr}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ContextMenu_AnalyzeQrCode]}"
                                          Command="{Binding AnalyzeQrCodeCommand}"
                                          IsEnabled="{Binding DataContext.IsQrCodeFeatureEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Pin]}"
                                          Command="{Binding TogglePinCommand}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_OpenImage]}"
                                          Command="{Binding OpenImageCommand}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_OpenFolder]}"
                                          Command="{Binding OpenFolderCommand}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_CopyImage]}"
                                          Command="{Binding CopyImageCommand}" />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ContextMenu_CreateMemo]}"
                                          Command="{Binding CreateMemoCommand}"
                                          IsEnabled="{Binding DataContext.IsMemoFeatureEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <Separator />
                                <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}"
                                          Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScreenshotItemViewModel}">
                    <Border BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,6" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FlashBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- サムネイル -->
                            <Border Grid.Column="0"
                                    Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Width="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Margin="0,0,10,0" Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="4" ClipToBounds="True"
                                    MouseDown="Thumbnail_MouseDown">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <!-- 代表色 + フォーマットバッジ -->
                                <Grid Margin="0,0,0,4">
                                    <ItemsControl ItemsSource="{Binding DominantColors}" HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="16" Height="16" Margin="0,0,4,0" Cursor="Hand"
                                                         Fill="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                         Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1"
                                                         ToolTip="{Binding}">
                                                    <Ellipse.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.CopyColorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Ellipse.InputBindings>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="4"
                                            Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Format}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Border>
                                </Grid>

                                <!-- タグ -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagBadgeTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Button x:Name="AddTagButton" Content="🏷️+"
                                            Style="{StaticResource CardIconButtonStyle}"
                                            Foreground="{DynamicResource TagIconBrush}"
                                            Width="Auto" Height="22" Padding="6,0" FontSize="11"
                                            Command="{Binding OpenTagPickerCommand}"
                                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_AddTag]}"
                                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_AddTag]}" />

                                    <Popup IsOpen="{Binding IsTagPickerOpen}" StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=AddTagButton}"
                                           Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="140">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[History_AddTag]}"
                                                           FontWeight="Bold" FontSize="11" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <ItemsControl ItemsSource="{Binding AvailableTagsToAdd}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Name}"
                                                                    HorizontalContentAlignment="Left"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="4,3" Cursor="Hand"
                                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                                    Command="{Binding PlacementTarget.DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                    CommandParameter="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[History_NoMoreTags]}"
                                                           FontSize="11" TextWrapping="Wrap" MaxWidth="150"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Visibility="{Binding HasNoAvailableTags, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </WrapPanel>

                                <!-- メモ / インライン編集 -->
                                <Grid MouseDown="NoteText_MouseDown">
                                    <TextBlock Text="{Binding Note}"
                                               TextWrapping="Wrap"
                                               MaxHeight="120"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontFamily="{Binding DataContext.MemoFontFamily, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               FontSize="{Binding DataContext.MemoFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <TextBox Text="{Binding EditingNote, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" MaxHeight="120" AcceptsReturn="True"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderBrush="{DynamicResource AccentBrush}"
                                             BorderThickness="1" Padding="4"
                                             PreviewKeyDown="NoteEditTextBox_PreviewKeyDown"
                                             Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <!-- フッター -->
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ToggleButton Style="{StaticResource PinToggleButtonStyle}"
                                                      Width="26" Height="26"
                                                      IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                      Command="{Binding TogglePinCommand}"
                                                      ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Pin]}"
                                                      AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Pin]}" />
                                        <Button Style="{StaticResource CardIconButtonStyle}" Content="✏️"
                                                Foreground="{DynamicResource EditIconBrush}"
                                                Command="{Binding BeginEditNoteCommand}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_EditNote]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_EditNote]}" />
                                        <Button Style="{StaticResource CardIconButtonStyle}" Content="🔍"
                                                Foreground="{DynamicResource SearchIconBrush}"
                                                Command="{Binding RunOcrCommand}"
                                                IsEnabled="{Binding CanRunOcr}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_Ocr]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_Ocr]}" />
                                        <Button Style="{StaticResource CardIconButtonStyle}" Content="📁"
                                                Foreground="{DynamicResource FolderIconBrush}"
                                                Command="{Binding OpenFolderCommand}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_OpenFolder]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tooltip_OpenFolder]}" />
                                        <Button Style="{StaticResource CardIconButtonStyle}" Content="📝"
                                                Foreground="{DynamicResource MemoIconBrush}"
                                                Command="{Binding CreateMemoCommand}"
                                                IsEnabled="{Binding DataContext.IsMemoFeatureEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ContextMenu_CreateMemo]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ContextMenu_CreateMemo]}" />
                                        <Button Style="{StaticResource CardIconButtonStyle}" Content="🗑️"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

<Window x:Class="HasamiBoard.Views.ConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:HasamiBoard.Services"
        xmlns:converters="clr-namespace:HasamiBoard.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_WindowTitle]}"
        Width="640" Height="580" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Topmost="{Binding IsTopmost}"
        FontFamily="{Binding UiFontFamily}"
        FontSize="{Binding UiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="ConverterWindow_PreviewKeyDown">

    <Window.Resources>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <HierarchicalDataTemplate x:Key="JqPathNodeTemplate" DataType="{x:Type services:JqPathNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
        </HierarchicalDataTemplate>

        <Style x:Key="SidebarModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarCategoryExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBd" Background="Transparent" Padding="10,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="&#9654;" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#9660;" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentHost" DockPanel.Dock="Bottom" Visibility="Collapsed" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConverterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ConverterInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource StandardTextBoxStyle}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="{Binding EditFontFamily}" />
            <Setter Property="FontSize" Value="{Binding EditFontSize}" />
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ヘッダー: フォント設定 / 常に手前に表示トグル -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,4" LastChildFill="False">
            <ToggleButton DockPanel.Dock="Right"
                          Style="{StaticResource PinToggleButtonStyle}"
                          IsChecked="{Binding IsTopmost, Mode=OneWay}"
                          Command="{Binding ToggleTopmostCommand}"
                          ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Pin]}"
                          AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Pin]}" />

            <Button x:Name="FontSettingsButton" DockPanel.Dock="Right" Content="🔤"
                    Style="{StaticResource IconButtonStyle}"
                    Click="FontSettingsButton_Click"
                    ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[MemoFontPanel_Title]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[MemoFontPanel_Title]}" />

            <Popup x:Name="FontSettingsPopup" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=FontSettingsButton}"
                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[MemoFontPanel_Title]}"
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,6"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Font_ConverterUi]}"
                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="150" Margin="0,0,6,0" IsEditable="True"
                                      ItemsSource="{Binding AvailableFontFamilies}"
                                      Text="{Binding UiFontFamily, Mode=TwoWay}" />
                            <ComboBox Width="55" IsEditable="True"
                                      Text="{Binding UiFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem>11</ComboBoxItem>
                                <ComboBoxItem>12</ComboBoxItem>
                                <ComboBoxItem>13</ComboBoxItem>
                                <ComboBoxItem>14</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>18</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Font_ConverterEdit]}"
                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="150" Margin="0,0,6,0" IsEditable="True"
                                      ItemsSource="{Binding AvailableFontFamilies}"
                                      Text="{Binding EditFontFamily, Mode=TwoWay}" />
                            <ComboBox Width="55" IsEditable="True"
                                      Text="{Binding EditFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem>11</ComboBoxItem>
                                <ComboBoxItem>12</ComboBoxItem>
                                <ComboBoxItem>13</ComboBoxItem>
                                <ComboBoxItem>14</ComboBoxItem>
                                <ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>18</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </DockPanel>

        <!-- サイドバー: 変換モード一覧 (カテゴリ別の折りたたみ表示) -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ModeSidebarPanel" Margin="0,8">
                    <Expander x:Name="CategoryEncodeDecodeExpander" Style="{StaticResource SidebarCategoryExpanderStyle}" Tag="EncodeDecode"
                              Expanded="CategoryExpander_Toggled" Collapsed="CategoryExpander_Toggled">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔤" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ConverterCategory_EncodeDecode]}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,0,0,4">
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Hash]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Hash, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Hash" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Base64]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Base64, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Base64" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Url]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Url, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Url" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Html]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Html, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Html" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_JwtDecoder]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JwtDecoder, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="JwtDecoder" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="CategoryFormatterExpander" Style="{StaticResource SidebarCategoryExpanderStyle}" Tag="Formatter"
                              Expanded="CategoryExpander_Toggled" Collapsed="CategoryExpander_Toggled">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ConverterCategory_Formatter]}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,0,0,4">
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Json]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Json, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Json" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Xml]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Xml, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Xml" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_HtmlFormat]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=HtmlFormat, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="HtmlFormat" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Css]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Css, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Css" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_JavaScript]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JavaScript, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="JavaScript" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Sql]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Sql, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Sql" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Jq]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Jq, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Jq" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="CategoryDateTimeExpander" Style="{StaticResource SidebarCategoryExpanderStyle}" Tag="DateTime"
                              Expanded="CategoryExpander_Toggled" Collapsed="CategoryExpander_Toggled">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ConverterCategory_DateTime]}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,0,0,4">
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Timestamp]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Timestamp, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Timestamp" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_CronParser]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CronParser, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="CronParser" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="CategoryGeneratorExpander" Style="{StaticResource SidebarCategoryExpanderStyle}" Tag="Generator"
                              Expanded="CategoryExpander_Toggled" Collapsed="CategoryExpander_Toggled">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ConverterCategory_Generator]}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,0,0,4">
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Uuid]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Uuid, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Uuid" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_Password]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Password, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="Password" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_QrCode]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=QrCode, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="QrCode" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_BasicAuth]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BasicAuth, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="BasicAuth" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="CategoryTextAnalysisExpander" Style="{StaticResource SidebarCategoryExpanderStyle}" Tag="TextAnalysis"
                              Expanded="CategoryExpander_Toggled" Collapsed="CategoryExpander_Toggled">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[ConverterCategory_TextAnalysis]}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,0,0,4">
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_RegexTester]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RegexTester, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="RegexTester" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_CaseConverter]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CaseConverter, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="CaseConverter" />
                            <RadioButton GroupName="ConverterModes" Style="{StaticResource SidebarModeButtonStyle}"
                                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Mode_NumberBaseConverter]}"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NumberBaseConverter, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}" CommandParameter="NumberBaseConverter" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="16">

            <!-- ハッシュ生成 -->
            <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Hash}">
                <TextBlock Style="{StaticResource ConverterLabelStyle}" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Input]}" />
                <TextBox Style="{StaticResource ConverterInputTextBoxStyle}" Height="110" Margin="0,0,0,12"
                         Text="{Binding HashInputText, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MD5" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Grid.Column="1" Style="{StaticResource ConverterInputTextBoxStyle}" AcceptsReturn="False" IsReadOnly="True" Margin="6,0" Text="{Binding Md5Result, Mode=OneWay}" />
                    <Button Grid.Column="2" Style="{StaticResource CardIconButtonStyle}" Content="📋" Foreground="{DynamicResource CopyIconBrush}"
                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Md5Result}"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SHA1" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Grid.Column="1" Style="{StaticResource ConverterInputTextBoxStyle}" AcceptsReturn="False" IsReadOnly="True" Margin="6,0" Text="{Binding Sha1Result, Mode=OneWay}" />
                    <Button Grid.Column="2" Style="{StaticResource CardIconButtonStyle}" Content="📋" Foreground="{DynamicResource CopyIconBrush}"
                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Sha1Result}"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SHA256" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Grid.Column="1" Style="{StaticResource ConverterInputTextBoxStyle}" AcceptsReturn="False" IsReadOnly="True" Margin="6,0" Text="{Binding Sha256Result, Mode=OneWay}" />
                    <Button Grid.Column="2" Style="{StaticResource CardIconButtonStyle}" Content="📋" Foreground="{DynamicResource CopyIconBrush}"
                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Sha256Result}"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SHA512" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Grid.Column="1" Style="{StaticResource ConverterInputTextBoxStyle}" AcceptsReturn="False" IsReadOnly="True" Margin="6,0" Text="{Binding Sha512Result, Mode=OneWay}" />
                    <Button Grid.Column="2" Style="{StaticResource CardIconButtonStyle}" Content="📋" Foreground="{DynamicResource CopyIconBrush}"
                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Sha512Result}"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Copy]}" />
                </Grid>
            </StackPanel>

            <!-- Base64 / URL / HTML エンコード・デコード -->
            <Grid Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Base64,Url,Html'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource ConverterLabelStyle}" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Input]}" />
                <TextBox Grid.Row="1" Style="{StaticResource ConverterInputTextBoxStyle}" MinHeight="80" Margin="0,0,0,8"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource StandardButtonStyle}" Padding="14,6" Margin="0,0,6,0"
                            Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Encode]}"
                            Command="{Binding EncodeCommand}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,6,0"
                            Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Decode]}"
                            Command="{Binding DecodeCommand}" />
                    <Button Style="{StaticResource CardIconButtonStyle}" Content="⇄"
                            Command="{Binding SwapCommand}"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Swap]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Swap]}" />
                    <Button Style="{StaticResource CardIconButtonStyle}" Content="🗑️" Foreground="{DynamicResource DangerBrush}"
                            Command="{Binding ClearCommand}"
                            ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Clear]}"
                            AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Clear]}" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Grid.Row="4" Style="{StaticResource ConverterLabelStyle}" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Converter_Output]}" />
                <Grid Grid.Row="5">
                    <TextBox Style="{StaticResource ConverterInputTextBoxStyle}" MinHeight="80" IsReadOnly="True" Padding="8,5,34,5"

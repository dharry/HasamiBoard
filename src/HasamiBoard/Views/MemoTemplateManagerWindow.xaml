<Window x:Class="HasamiBoard.Views.MemoTemplateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:HasamiBoard.Services"
        xmlns:models="clr-namespace:HasamiBoard.Models"
        Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Template_ManagerTitle]}"
        Width="480" Height="520" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource StandardButtonStyle}"
                    Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Template_New]}"
                    Click="NewTemplateButton_Click"
                    FontSize="12" Padding="10,4" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Template_ManagerTitle]}"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
        </DockPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Template_Empty]}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />

        <ListBox x:Name="TemplateListBox" Grid.Row="1"
                 ItemsSource="{Binding Templates}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:MemoTemplate}">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,6" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Border Background="{DynamicResource HoverBrush}" CornerRadius="4"
                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Mode}" FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource CardIconButtonStyle}" Content="✏️"
                                        Foreground="{DynamicResource EditIconBrush}"
                                        Click="EditTemplateButton_Click" Tag="{Binding}"
                                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Edit]}"
                                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Edit]}" />
                                <Button Style="{StaticResource CardIconButtonStyle}" Content="🗑️"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Click="DeleteTemplateButton_Click" Tag="{Binding}"
                                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}"
                                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Button_Delete]}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>

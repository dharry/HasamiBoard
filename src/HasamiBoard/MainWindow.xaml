<Window x:Class="HasamiBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HasamiBoard.Views"
        xmlns:converters="clr-namespace:HasamiBoard.Converters"
        xmlns:services="clr-namespace:HasamiBoard.Services"
        Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[AppTitle]}"
        MinWidth="320" MinHeight="420"
        Topmost="{Binding IsTopmost}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibilityConverter" />
        <converters:IndexToBoolConverter x:Key="IndexToBoolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton Grid.Column="0"
                    Style="{StaticResource PinToggleButtonStyle}"
                    IsChecked="{Binding IsTopmost, Mode=OneWay}"
                    Command="{Binding ToggleTopmostCommand}"
                    ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Pin]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Pin]}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="🎨"
                        Foreground="{DynamicResource ColorPickerIconBrush}"
                        Click="ColorPickerButton_Click"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_ColorPicker]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_ColorPicker]}" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="🔁"
                        Foreground="{DynamicResource ConverterIconBrush}"
                        Click="ConverterButton_Click"
                        Visibility="{Binding IsConverterEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Converter]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Converter]}" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="⚠️"
                        Foreground="{DynamicResource ErrorListIconBrush}"
                        Click="ErrorListButton_Click"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_ErrorList]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_ErrorList]}" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="⚙️"
                        Foreground="{DynamicResource SettingsIconBrush}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Settings]}"
                        Command="{Binding ToggleSettingsPanelCommand}"
                        ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Header_Settings]}" />
            </StackPanel>
        </Grid>

        <!-- ナビゲーションタブ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4"
                    PreviewMouseLeftButtonDown="NavTabs_PreviewMouseLeftButtonDown">
            <RadioButton Style="{StaticResource NavTabButtonStyle}"
                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_History]}"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=0, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="0"
                         Visibility="{Binding IsHistoryTabEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,0,4,0" />
            <RadioButton Style="{StaticResource NavTabButtonStyle}"
                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_Screenshot]}"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=1, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="1"
                         Visibility="{Binding IsScreenshotTabEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="4,0" />
            <RadioButton Style="{StaticResource NavTabButtonStyle}"
                         Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_Memo]}"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=2, Mode=OneWay}"
                         Command="{Binding SelectTabCommand}" CommandParameter="2"
                         Visibility="{Binding IsMemoTabEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="4,0,0,0" />
        </StackPanel>

        <!-- タブコンテンツ -->
        <Grid Grid.Row="2" Margin="10,4">
            <views:ClipboardHistoryView DataContext="{Binding ClipboardHistory}"
                                         Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}" />
            <views:ScreenshotView DataContext="{Binding Screenshot}"
                                  Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}" />
            <views:MemoView x:Name="MemoViewControl" DataContext="{Binding Memo}"
                            Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}" />
        </Grid>

        <!-- クイックフィルター -->
        <Grid Grid.Row="3"
              Height="34"
              Visibility="{Binding IsQuickFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBox x:Name="QuickFilterTextBox"
                     Style="{StaticResource QuickFilterTextBoxStyle}"
                     Padding="34,5,30,5"
                     Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[QuickFilter_Placeholder]}" />

            <!-- 虫眼鏡アイコン -->
            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                  Fill="{DynamicResource SecondaryTextBrush}"
                  Stretch="Uniform"
                  Width="14" Height="14"
                  HorizontalAlignment="Left" Margin="14,0,0,0"
                  IsHitTestVisible="False" />

            <!-- クリアボタン -->
            <Button Style="{StaticResource IconButtonStyle}"
                    Content="✕"
                    Width="24" Height="24" FontSize="11"
                    HorizontalAlignment="Right" Margin="0,0,3,0"
                    Command="{Binding ClearQuickFilterCommand}"
                    Visibility="{Binding QuickFilterText, Converter={StaticResource StringToVisibilityConverter}}"
                    ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[QuickFilter_Clear]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[QuickFilter_Clear]}" />
        </Grid>

        <!-- 入力補助 (レコード数/上限 + Vimキーバインドのヒント) -->
        <Border Grid.Row="4"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding RecordCountText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[VimHintBar]}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 設定パネル (右側オーバーレイ) -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsSettingsPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#66000000" MouseDown="SettingsBackdrop_MouseDown" />
            <views:SettingsPanel Width="320" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
